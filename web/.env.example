# smart_monitor_v1 - web dashboard configuration
# Copy to `.env` for local overrides. Safe defaults are already in vite.config.js.

# Origin of the API during development (proxied, never called directly).
VITE_API_PROXY=http://localhost:5000

# Only needed when the bundle is served from a different origin (production).
# Leave empty in development: requests then go through the dev proxy.
VITE_API_BASE_URL=
