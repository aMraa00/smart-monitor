# ------------------------------------------------------------------
# smart_monitor_v1 - backend environment configuration
# Copy to `.env` and fill in REAL values. NEVER commit `.env`.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# Comma separated list of allowed browser origins
CLIENT_URL=http://localhost:5173

# MongoDB connection string. Mongo is NEVER exposed to devices.
# Development uses the local mongod; switch to Atlas by uncommenting the line below.
MONGO_URI=mongodb://127.0.0.1:27017/smart_monitor_v1
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/uhaalag_monitor_v1

# --- user auth (JWT) ---
JWT_ACCESS_SECRET=<generate-secure-secret>
JWT_REFRESH_SECRET=<generate-secure-secret>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- device auth (HMAC) ---
# Secret used to hash the per-device HMAC secret and sign provisioning tokens.
DEVICE_TOKEN_SECRET=<generate-secure-secret>
# Reject device requests whose clock differs by more than this many seconds.
DEVICE_MAX_CLOCK_SKEW_S=300
# Nonce replay window (seconds) - also the TTL of the nonce cache.
DEVICE_NONCE_TTL_S=600
# Batches larger than this are rejected (DoS guard).
TELEMETRY_MAX_BATCH=120

# --- provisioning ---
# How long a provisioning token / claim code stays valid.
PROVISIONING_TOKEN_TTL_S=900
CLAIM_CODE_TTL_S=900

# --- rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# --- redis (optional) ---
# When empty, an in-memory nonce cache / rate-limit store is used (single instance only).
REDIS_URL=

# --- logging ---
LOG_LEVEL=info
